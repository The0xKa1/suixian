{
  "name": "suixian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:omr": "python3 server/omr_service.py",
    "setup:omr": "python3 scripts/setup-omr.py",
    "test:omr": "python3 -m unittest discover -s server -p 'test_*.py'",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts src/lib/score-following/*.test.ts",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "lucide-react": "^0.468.0",
    "opensheetmusicdisplay": "^2.1.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
